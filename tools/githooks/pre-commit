#!/usr/bin/env bash
# Blocks a commit that would put personal data into a public artifact.
#
# Enable once per clone (hooks in .git/hooks are not versioned; this dir is):
#   git config core.hooksPath tools/githooks
#
# Bypassable with --no-verify by design; CI runs the same check and is not.
set -uo pipefail

repo=$(git rev-parse --show-toplevel)
cd "$repo" || exit 1

# 1. Never allow a live memory file to be staged, even if .gitignore is edited.
blocked=$(git diff --cached --name-only |
  grep -E '(HealthMonitoringNorms|SleepSignatureLog)\.md$' |
  grep -v '\.example\.md$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit a live memory file:"
  echo "$blocked" | sed 's/^/  /'
  echo "These hold personal records. They belong in the Minowa document store."
  exit 1
fi

# 2. Any staged archive must not contain a dated or non-template memory file.
for z in $(git diff --cached --name-only | grep -E '\.skill$|\.zip$' || true); do
  [ -f "$z" ] || continue
  if unzip -Z1 "$z" | grep -qE '20[0-9]{2}-[0-9]{2}-[0-9]{2}'; then
    echo "pre-commit: $z contains a dated file — rebuild with tools/build-skills.sh"
    exit 1
  fi
done

# 3. Full public-safety scan.
exec ./tools/check-public-safe.sh
